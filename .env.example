# Buat .env dengan sh scripts/dev-env.sh, atau isi nilai sendiri untuk setup manual.
# Jangan commit .env dan jangan mengganti kunci enkripsi setelah ada kredensial tersimpan.
PLATFORM_DATABASE_DSN=
DATABASE_CREDENTIALS_KEY=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
APP_ENV=development
APP_ORIGIN=http://localhost:8080
HTTP_ADDR=127.0.0.1:8080
POSTGRES_ADMIN_PASSWORD=
MARIADB_ADMIN_PASSWORD=
INTERNAL_DATABASE_PASSWORD=
TARGET_EXECUTOR_PASSWORD=
TARGET_AUDIT_PASSWORD=
# Impor legacy hanya bila diaktifkan secara eksplisit:
IMPORT_LEGACY_IDENTITY=
IMPORT_LEGACY_DATABASES=
# Cluster disposable localhost dengan nama database atlas_test*:
TEST_PLATFORM_DSN=
TEST_MARIADB_ADMIN_DSN=
